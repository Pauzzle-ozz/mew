# =====================================================================
# Configuration du frontend Mew
#
# Copie ce fichier en « .env.local » (dans ce meme dossier frontend/) :
#     cp .env.example .env.local
#
# /!\ AVERTISSEMENT IMPORTANT /!\
# Dans Next.js, toute variable qui commence par NEXT_PUBLIC_ est
# integree au code envoye au navigateur. N'importe qui peut la lire
# en ouvrant les outils de developpement.
# N'y mets JAMAIS une cle secrete (cle OpenAI, cle service_role...).
# =====================================================================


# Adresse du backend. Doit correspondre au PORT du backend.
NEXT_PUBLIC_API_URL=http://localhost:5000


# ---------------------------------------------------------------------
# AUTHENTIFICATION  (facultatif)
#
# « local »    : aucun compte, aucun mot de passe. Tu ouvres l'app et
#                tu t'en sers. C'est le mode par defaut, pense pour un
#                usage personnel sur ta propre machine.
# « supabase » : comptes et mots de passe, pour heberger Mew en ligne
#                et le partager avec plusieurs personnes.
# ---------------------------------------------------------------------

NEXT_PUBLIC_AUTH_MODE=local

# Uniquement si NEXT_PUBLIC_AUTH_MODE=supabase.
# La cle « anon » est prevue pour etre publique : c'est la seule cle
# Supabase qu'on a le droit de mettre ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
