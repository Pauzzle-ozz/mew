# =====================================================================
# Configuration du backend Mew
#
# Copie ce fichier en « .env » (dans ce meme dossier backend/) :
#     cp .env.example .env
#
# AUCUNE de ces variables n'est obligatoire pour demarrer.
# Le serveur se lance toujours et t'affiche au demarrage ce qui est
# actif et ce qui ne l'est pas. Chaque cle que tu ajoutes debloque
# une fonctionnalite en plus.
# =====================================================================


# ---------------------------------------------------------------------
# INTELLIGENCE ARTIFICIELLE  (facultatif — et normalement, tu n'as RIEN
# a mettre ici)
#
# Le fournisseur d'IA se choisit maintenant dans l'ECRAN PARAMETRES :
#     http://localhost:3000/parametres
# Tu y choisis ton fournisseur (OpenAI, Claude, Gemini, Kimi, Mistral,
# Ollama en local...), tes modeles, ta cle. Tu peux tester avant
# d'enregistrer. Ton choix est range dans backend/data/config-ia.json.
#
# Sans rien du tout : les outils fonctionnent quand meme. Tout ce qui est
# calculable (score ATS, correspondance CV/offre, metiers, suivi des
# candidatures) est fait en local par du code, gratuitement. Le modele ne
# sert qu'aux 6 appels de REDACTION : lettre de motivation, email de
# candidature, reformulation des experiences, extraction de profil.
#
#
# ORDRE DE PRIORITE — important
#
#   1. CE FICHIER, s'il definit OPENAI_API_KEY ci-dessous.  <- GAGNE TOUJOURS
#   2. backend/data/config-ia.json, le choix fait dans l'ecran Parametres.
#   3. rien du tout, et Mew demarre quand meme.
#
# Le .env garde la main parce que quelqu'un peut installer Mew POUR
# d'autres (serveur partage, association, centre de formation) et vouloir
# imposer sa configuration. Dans ce cas l'ecran Parametres affiche le
# choix comme VERROUILLE, au lieu de laisser croire qu'on peut le changer.
#
# Donc : si tu remplis OPENAI_API_KEY ici, plus personne ne pourra choisir
# son modele depuis l'interface. Pour rendre la main, vide cette variable
# et relance le serveur.
#
# ATTENTION : une cle mise ici est PARTAGEE par tous ceux qui utilisent
# cette installation, et c'est toi qui payes. Lis SECURITY.md avant.
#
# Enfin, cette voie ne parle que le protocole COMPATIBLE OPENAI. Anthropic
# et Google, qui ont leur propre format d'API, ne sont joignables que par
# l'ecran Parametres.
# ---------------------------------------------------------------------

# Cle API. Laisse VIDE pour laisser l'utilisateur choisir dans l'interface.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Adresse de l'API, si tu n'utilises pas OpenAI. Laisse vide pour OpenAI.
#   Ollama    -> http://localhost:11434/v1
#   LM Studio -> http://localhost:1234/v1
#   Groq      -> https://api.groq.com/openai/v1
#   Mistral   -> https://api.mistral.ai/v1
# Note : une adresse locale suffit a elle seule (Ollama ignore la cle),
# meme si OPENAI_API_KEY reste vide.
OPENAI_BASE_URL=

# Modeles utilises, par role. Ils ne s'appliquent que si ce fichier
# impose la configuration (points 1 ci-dessus).
# « redaction » a besoin d'un bon modele, « extraction » d'un modele rapide.
AI_MODEL_REDACTION=gpt-4o
AI_MODEL_EXTRACTION=gpt-4.1-mini

# Delai maximum d'attente d'une reponse du modele, en millisecondes.
# 120000 = 2 minutes. A augmenter si tu utilises un gros modele local :
# il peut charger plusieurs gigaoctets avant sa premiere reponse.
AI_TIMEOUT_MS=120000

# Nombre maximum de requetes IA par tranche de 15 minutes.
# Mets 0 pour desactiver completement la limite (usage local solo).
AI_RATE_LIMIT_MAX=200


# ---------------------------------------------------------------------
# ENVOI D'EMAIL  (facultatif)
#
# Sert uniquement a la candidature spontanee. Sans cle, l'email est
# quand meme redige : tu le copies dans ta propre messagerie.
# ---------------------------------------------------------------------

# Cle API Resend. https://resend.com/api-keys
RESEND_API_KEY=

# Adresse expediteur. Par defaut Resend n'autorise que son adresse de
# test « onboarding@resend.dev », qui n'ecrit qu'au titulaire du compte :
# pour ecrire a un vrai recruteur, il faut verifier ton propre domaine.
EMAIL_FROM=


# ---------------------------------------------------------------------
# DECOUVERTE D'OFFRES  (facultatif)
#
# France Travail expose une API officielle et gratuite. C'est la source
# la plus propre : pas de scraping, pas de zone grise juridique.
# Inscription : https://francetravail.io
# ---------------------------------------------------------------------

FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Scraping des autres sites d'emploi (Welcome to the Jungle, Indeed,
# HelloWork, APEC). Desactive par defaut : verifie les conditions
# d'utilisation de ces sites avant de l'activer.
# Necessite aussi Puppeteer (~1,3 Go de Chromium telecharges).
SCRAPING_ENABLED=false


# ---------------------------------------------------------------------
# STOCKAGE  (facultatif)
#
# Par defaut, tes candidatures et ton historique sont enregistres dans
# un simple fichier « backend/data/mew.json », sur ta machine.
# Rien ne part sur internet, et tu peux le sauvegarder ou l'effacer
# toi-meme quand tu veux.
# ---------------------------------------------------------------------

# « json » (defaut, local) ou « supabase » (base en ligne, multi-utilisateur)
STORAGE_DRIVER=json

# Uniquement si STORAGE_DRIVER=supabase.
# ATTENTION : la cle service_role contourne toutes les regles de
# securite de la base. Elle ne doit JAMAIS se retrouver cote navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cle « anon » (publique) du meme projet Supabase. Elle sert uniquement a
# verifier les jetons de connexion quand AUTH_MODE=supabase (voir plus bas).
# A defaut, SUPABASE_SERVICE_KEY est utilisee, mais la cle anon est preferable.
SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------
# AUTHENTIFICATION  (facultatif)
#
# Qui a le droit de lire les candidatures et l'historique enregistres.
# ---------------------------------------------------------------------

# « local » (defaut) : usage personnel, un seul utilisateur. Le serveur fait
#   confiance a l'identifiant que le navigateur lui envoie. C'est suffisant
#   tant que le serveur n'ecoute que sur 127.0.0.1 (voir HOST plus bas), donc
#   tant que personne d'autre ne peut l'atteindre.
#
# « supabase » : plusieurs utilisateurs. Le serveur exige un jeton de
#   connexion (« Authorization: Bearer ... ») et le verifie aupres de
#   Supabase. Une donnee envoyee par le client ne prouve jamais son
#   identite ; seul un jeton signe, verifie cote serveur, le fait.
#   Necessite SUPABASE_URL et SUPABASE_ANON_KEY ci-dessus.
#
# ATTENTION : en mode supabase, le frontend doit envoyer le jeton. Ne bascule
# pas ce reglage sans verifier que l'interface suit, sinon elle recevra des 401.
AUTH_MODE=local


# ---------------------------------------------------------------------
# SERVEUR
# ---------------------------------------------------------------------

# Port d'ecoute. Sur macOS, le port 5000 est pris par AirPlay : mets 5001
# (et adapte NEXT_PUBLIC_API_URL dans frontend/.env.local).
PORT=5000

# Adresse d'ecoute. « 127.0.0.1 » = accessible uniquement depuis ta
# machine. Ne mets « 0.0.0.0 » que si tu sais pourquoi tu le fais.
HOST=127.0.0.1

# Origine autorisee a appeler l'API (protection CORS).
FRONTEND_URL=http://localhost:3000

# « development » affiche le detail des erreurs, « production » les masque.
NODE_ENV=development

# Niveau de detail des logs : error | warn | info | debug
LOG_LEVEL=info
