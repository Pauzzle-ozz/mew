# =====================================================================
# Configuration du backend Mew
#
# Copie ce fichier en « .env » (dans ce meme dossier backend/) :
#     cp .env.example .env
#
# AUCUNE de ces variables n'est obligatoire pour demarrer.
# Le serveur se lance toujours et t'affiche au demarrage ce qui est
# actif et ce qui ne l'est pas. Chaque cle que tu ajoutes debloque
# une fonctionnalite en plus.
# =====================================================================


# ---------------------------------------------------------------------
# INTELLIGENCE ARTIFICIELLE  (facultatif)
#
# Sans cle : les outils fonctionnent quand meme. Tout ce qui est
# calculable (score ATS, correspondance CV/offre, metiers, suivi des
# candidatures) est fait en local par du code, gratuitement.
# La cle ne sert qu'aux trois taches de REDACTION : lettre de
# motivation, email de candidature, reformulation des experiences.
# ---------------------------------------------------------------------

# Cle API OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Pour utiliser un autre fournisseur ou un modele qui tourne sur ta
# machine, il suffit de changer cette adresse. Laisse vide pour OpenAI.
#   Ollama    -> http://localhost:11434/v1
#   LM Studio -> http://localhost:1234/v1
#   Groq      -> https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Modeles utilises, par role.
# « redaction » a besoin d'un bon modele, « extraction » d'un modele rapide.
AI_MODEL_REDACTION=gpt-4o
AI_MODEL_EXTRACTION=gpt-4.1-mini

# Nombre maximum de requetes IA par tranche de 15 minutes.
# Mets 0 pour desactiver completement la limite (usage local solo).
AI_RATE_LIMIT_MAX=200


# ---------------------------------------------------------------------
# ENVOI D'EMAIL  (facultatif)
#
# Sert uniquement a la candidature spontanee. Sans cle, l'email est
# quand meme redige : tu le copies dans ta propre messagerie.
# ---------------------------------------------------------------------

# Cle API Resend. https://resend.com/api-keys
RESEND_API_KEY=

# Adresse expediteur. Par defaut Resend n'autorise que son adresse de
# test « onboarding@resend.dev », qui n'ecrit qu'au titulaire du compte :
# pour ecrire a un vrai recruteur, il faut verifier ton propre domaine.
EMAIL_FROM=


# ---------------------------------------------------------------------
# DECOUVERTE D'OFFRES  (facultatif)
#
# France Travail expose une API officielle et gratuite. C'est la source
# la plus propre : pas de scraping, pas de zone grise juridique.
# Inscription : https://francetravail.io
# ---------------------------------------------------------------------

FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Scraping des autres sites d'emploi (Welcome to the Jungle, Indeed,
# HelloWork, APEC). Desactive par defaut : verifie les conditions
# d'utilisation de ces sites avant de l'activer.
# Necessite aussi Puppeteer (~1,3 Go de Chromium telecharges).
SCRAPING_ENABLED=false


# ---------------------------------------------------------------------
# STOCKAGE  (facultatif)
#
# Par defaut, tes candidatures et ton historique sont enregistres dans
# un simple fichier « backend/data/mew.json », sur ta machine.
# Rien ne part sur internet, et tu peux le sauvegarder ou l'effacer
# toi-meme quand tu veux.
# ---------------------------------------------------------------------

# « json » (defaut, local) ou « supabase » (base en ligne, multi-utilisateur)
STORAGE_DRIVER=json

# Uniquement si STORAGE_DRIVER=supabase.
# ATTENTION : la cle service_role contourne toutes les regles de
# securite de la base. Elle ne doit JAMAIS se retrouver cote navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# ---------------------------------------------------------------------
# SERVEUR
# ---------------------------------------------------------------------

# Port d'ecoute. Sur macOS, le port 5000 est pris par AirPlay : mets 5001
# (et adapte NEXT_PUBLIC_API_URL dans frontend/.env.local).
PORT=5000

# Adresse d'ecoute. « 127.0.0.1 » = accessible uniquement depuis ta
# machine. Ne mets « 0.0.0.0 » que si tu sais pourquoi tu le fais.
HOST=127.0.0.1

# Origine autorisee a appeler l'API (protection CORS).
FRONTEND_URL=http://localhost:3000

# « development » affiche le detail des erreurs, « production » les masque.
NODE_ENV=development

# Niveau de detail des logs : error | warn | info | debug
LOG_LEVEL=info
